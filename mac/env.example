# ~/Library/Application Support/Kal/.env — chmod 600. NEVER commit this file.
# The desk refuses to boot if this file is readable by anyone but you.

# Kalshi API key (the private key on ONE line with \n escapes, or use the
# base64 form below instead)
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY=
# KALSHI_PRIVATE_KEY_PEM_BASE64=

# Telegram (accounting + alerts only; LIVE refuses to boot without it)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Pyth Hermes key — only if Kalshi's pyth_value channel does not carry
# metals/oil/FX (WO-ROT-1 Chunk 6). Leave empty otherwise.
PYTH_API_KEY=

# Born state: SHADOW. Going live is Drew's act: RUN_MODE=LIVE plus the
# I_UNDERSTAND_LIVE phrase (see relay_engine/config.py).
RUN_MODE=SHADOW
DESK_MODE=ROTATION
